% Código-fonte (shell)
\lstset{
    basicstyle=\ttfamily\small,
    breaklines=true,
    frame=single,
    numbers=left,
    numberstyle=\tiny,
    showstringspaces=false,
    keepspaces=true,
    inputencoding=utf8,
    extendedchars=true,
    literate=
    {á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
    {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
    {à}{{\`a}}1 {À}{{\`A}}1 {ã}{{\~a}}1 {õ}{{\~o}}1 {Ã}{{\~A}}1 {Õ}{{\~O}}1
    {ç}{{\c{c}}}1 {Ç}{{\c{C}}}1 {ê}{{\^e}}1 {ô}{{\^o}}1 {â}{{\^a}}1
    {Ê}{{\^E}}1 {Ô}{{\^O}}1 {Â}{{\^A}}1
}
\renewcommand{\lstlistingname}{Código}
\providecommand*{\lstlistingautorefname}{Código}

% Captura de tela do terminal: \printterminal{arquivo}{legenda}{rótulo}
\graphicspath{{figuras/}}
\newcommand{\printterminal}[3]{%
\begin{figure}[H]
    \centering
    \includegraphics[width=\linewidth,height=0.42\textheight,keepaspectratio]{#1}%
    \caption{#2}
    \label{#3}
    \legend{Fonte: os autores (2026).}
\end{figure}}

